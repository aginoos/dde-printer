#!/bin/sh
set -e

case "$1" in
    configure)
        # Make running instances pick up the new binaries.
        if pidof dde-printer >/dev/null 2>&1; then
            killall -q dde-printer || true
        fi
        if pidof dde-printer-helper >/dev/null 2>&1; then
            killall -q -USR1 dde-printer-helper || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
